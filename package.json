{
  "name": "reel-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Arma reels de Instagram a partir de clips crudos y una voz en off",
  "type": "module",
  "scripts": {
    "reel": "tsx src/cli.ts",
    "limpiar": "tsx src/cli.ts limpiar",
    "transcribir": "tsx src/cli.ts transcribir",
    "inventario": "tsx src/cli.ts inventario",
    "validar": "tsx src/cli.ts validar",
    "render": "tsx src/cli.ts render",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@ricky0123/vad-node": "0.0.3",
    "tsx": "4.20.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
