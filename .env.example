# Clave de ElevenLabs para transcribir la voz en off
# La sacás en https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Clave de Edits para Mac, para armar el reel en Edits
# En Edits: Ajustes › Automation, prendé el servidor de automatización y copiá la clave (Access token)
EDITS_TOKEN=
